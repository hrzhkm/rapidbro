generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Todo {
  id        Int      @id @default(autoincrement())
  title     String
  createdAt DateTime @default(now())
}

model Feedback {
  id        Int      @id @default(autoincrement())
  message   String
  region    String?
  createdAt DateTime @default(now())
}
